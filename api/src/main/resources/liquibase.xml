<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!-- Import Audit Log Table -->
    <changeSet id="dataimport-001" author="dataimport-module">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dataimport_audit_log"/>
            </not>
        </preConditions>
        <comment>Create import audit log table for tracking import history</comment>
        <createTable tableName="dataimport_audit_log">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="batch_id" type="char(38)">
                <constraints nullable="false"/>
            </column>
            <column name="filename" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_rows" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="successful_rows" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="quarantined_rows" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="patients_created" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="encounters_created" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="obs_created" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="location_uuid" type="char(38)">
                <constraints nullable="true"/>
            </column>
            <column name="form_uuids" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="error_summary" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="duration_ms" type="bigint">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="dataimport_audit_log" indexName="idx_dataimport_audit_batch_id">
            <column name="batch_id"/>
        </createIndex>
        <createIndex tableName="dataimport_audit_log" indexName="idx_dataimport_audit_date">
            <column name="date_created"/>
        </createIndex>
        <createIndex tableName="dataimport_audit_log" indexName="idx_dataimport_audit_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="dataimport_audit_log" indexName="idx_dataimport_audit_creator">
            <column name="creator"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="fk_dataimport_audit_creator"
                                 baseTableName="dataimport_audit_log" baseColumnNames="creator"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
    </changeSet>

    <!-- Import Audit Log Error Details Table -->
    <changeSet id="dataimport-002" author="dataimport-module">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dataimport_audit_error"/>
            </not>
        </preConditions>
        <comment>Create import audit error details table</comment>
        <createTable tableName="dataimport_audit_error">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="audit_log_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="sheet_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="row_index" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="column_index" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="error_code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="text">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="dataimport_audit_error" indexName="idx_dataimport_error_audit_id">
            <column name="audit_log_id"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="fk_dataimport_error_audit"
                                 baseTableName="dataimport_audit_error" baseColumnNames="audit_log_id"
                                 referencedTableName="dataimport_audit_log" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
