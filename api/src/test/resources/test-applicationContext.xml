<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <!-- Test-specific bean configurations -->
    <context:component-scan base-package="org.openmrs.module.dataimport.api.impl" />
    
    <!-- Mock beans for testing -->
    <bean id="formDefinitionClient" class="org.mockito.Mockito" factory-method="mock">
        <constructor-arg value="org.openmrs.module.dataimport.api.FormDefinitionClient"/>
    </bean>

</beans>
