<htmlform>
  <!-- Form with Conditional Fields using hideWhenExpression -->

  <encounterDate/>

  <!-- Primary Questions -->
  <obs conceptId="CIEL:3001" labelText="Gender" style="radio"/>
  <obs conceptId="CIEL:3002" labelText="Pregnant" style="radio"/>
  <obs conceptId="CIEL:3003" labelText="Has Surgery History" style="radio"/>
  <obs conceptId="CIEL:3004" labelText="Diabetic" style="radio"/>

  <!-- Conditional Fields -->
  <obs conceptId="CIEL:3005" labelText="Gestational Age (weeks)" style="number"
       hideWhenExpression="pregnant != 'Yes' || gender != 'Female'"/>

  <obs conceptId="CIEL:3006" labelText="Expected Delivery Date" style="date"
       hideWhenExpression="pregnant != 'Yes'"/>

  <obs conceptId="CIEL:3007" labelText="Previous Surgery Type" style="text"
       hideWhenExpression="hasSurgeryHistory != 'Yes'"/>

  <obs conceptId="CIEL:3008" labelText="Previous Surgery Date" style="date"
       hideWhenExpression="hasSurgeryHistory != 'Yes'"/>

  <obs conceptId="CIEL:3009" labelText="Diabetes Type" style="dropdown"
       hideWhenExpression="diabetic != 'Yes'"/>

  <obs conceptId="CIEL:3010" labelText="Insulin Dependent" style="radio"
       hideWhenExpression="diabetic != 'Yes'"/>

  <obs conceptId="CIEL:3011" labelText="HbA1c Level" style="number"
       hideWhenExpression="diabetic != 'Yes'"/>

  <!-- Additional Information -->
  <obs conceptId="CIEL:3012" labelText="Notes" style="text"/>
</htmlform>
