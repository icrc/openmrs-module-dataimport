{
  "$schema": "http://json.openmrs.org/form.schema.json",
  "name": "Sample Form with Repeat Groups",
  "uuid": "test-form-repeat-uuid",
  "version": "1.0",
  "processor": "EncounterFormProcessor",
  "encounterType": "encounter-type-uuid",
  "published": false,
  "retired": false,
  "pages": [
    {
      "label": "Main Page",
      "sections": [
        {
          "label": "Patient Information",
          "questions": [
            {
              "label": "Patient Name",
              "type": "obs",
              "id": "patient_name",
              "questionOptions": {
                "rendering": "text",
                "concept": "patient.name.concept.uuid"
              }
            }
          ]
        },
        {
          "label": "Vitals",
          "questions": [
            {
              "label": "Vitals Group",
              "type": "obsGroup",
              "id": "vitals_group",
              "questionOptions": {
                "rendering": "repeating",
                "concept": "vitals.group.concept.uuid",
                "repeatOptions": {
                  "addText": "Add Vitals",
                  "limit": "10"
                }
              },
              "questions": [
                {
                  "label": "Temperature",
                  "type": "obs",
                  "id": "temperature",
                  "questionOptions": {
                    "rendering": "number",
                    "concept": "temperature.concept.uuid",
                    "min": "30",
                    "max": "45"
                  }
                },
                {
                  "label": "Blood Pressure",
                  "type": "obs",
                  "id": "blood_pressure",
                  "questionOptions": {
                    "rendering": "text",
                    "concept": "blood.pressure.concept.uuid"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "referencedForms": []
}
